# oHRganize — Umgebungsvariablen EINER Kundeninstanz (Vorlage)
#
# Diese Datei ist die Vorlage, aus der ohrganize-provision.sh
# /etc/ohrganize/kunden/<kunde>.env erzeugt. Die Platzhalter __KUNDE__,
# __PORT__ und __DOMAIN__ werden dabei ersetzt. Von Hand kopieren geht auch:
#   install -m 0640 -o root -g ohrganize deploy/ohrganize-kunde.env.example \
#     /etc/ohrganize/kunden/musterfirma.env
#   editor /etc/ohrganize/kunden/musterfirma.env
#
# Nach jeder Änderung: systemctl restart ohrganize-backend@<kunde>
#
# Die vollständige Erklärung ALLER Variablen steht in ohrganize.env.example.
# Hier stehen nur die, die je Kunde verschieden sein müssen — plus die
# Begründung, warum sie verschieden sein müssen.


# ---------------------------------------------------------------------------
# Ausgabe (Variante), PFLICHT im Hosting
# ---------------------------------------------------------------------------
# Land x Edition, genau wie im Namen des Release-Archivs und in VARIANTE.txt.
# Das Backend vergleicht den Wert beim Start mit der einkompilierten Variante
# und verweigert bei Abweichung den Start (apps/backend/src/config.ts). Das
# ist der Stolperdraht gegen den teuersten Fehler im Hosting: einen Symlink,
# der auf das Release einer FREMDEN Ausgabe zeigt. Ohne ihn liefe die Instanz
# still mit anderem Funktionsumfang und naehme spaeter keine Lizenz mehr an.
#
# ohrganize-provision.sh setzt den Wert beim Anlegen (--variante) und
# ohrganize-update.sh prueft ihn vor jedem Umschalten.
OHRGANIZE_VARIANT=__VARIANTE__


# ---------------------------------------------------------------------------
# Initialpasswort nicht ins Journal, im Hosting Pflicht
# ---------------------------------------------------------------------------
# Bei der Erstinbetriebnahme erzeugt der Server ein Zufallspasswort fuer
# admin@ohrganize.de. Ohne diese Variable steht es im Journal, und dort liest
# es jeder mit Journalzugriff, im Mehrkundenbetrieb also der Betreiber samt
# Monitoring und Logversand. Mit dem Wert 1 nennt der Start nur den Pfad der
# Datei (0600 im Datenverzeichnis); abholen mit
#   ohrganize-provision.sh passwort <kunde>
# und danach loeschen mit
#   ohrganize-provision.sh passwort <kunde> --loeschen
OHRGANIZE_QUIET_INITIAL_PASSWORD=1


# ---------------------------------------------------------------------------
# Datenverzeichnis — je Kunde eigen, PFLICHT
# ---------------------------------------------------------------------------
# Zeigt auf dasselbe Verzeichnis, das die Unit über StateDirectory=ohrganize/%i
# anlegt. Zwei Instanzen mit demselben Datenverzeichnis wären zwei Prozesse auf
# einer SQLite-Datei — genau der Betrieb, für den oHRganize nicht ausgelegt ist.
# Hier liegen ohrganize.db, storage/, secret.key und lizenz.ohrganize — die
# Lizenz ist an die Installations-ID DIESER Datenbank gebunden, also je Kunde
# eine eigene Datei (docs/lizenzierung.md).
OHRGANIZE_DATA_DIR=/var/lib/ohrganize/__KUNDE__


# ---------------------------------------------------------------------------
# Port — je Kunde eigen, PFLICHT
# ---------------------------------------------------------------------------
# Der Reverse-Proxy schlägt anhand der Subdomain in /etc/nginx/ohrganize-kunden.map
# genau diesen Port nach. Wird er hier geändert, muss die Zeile in der Map
# mitgeändert werden — sonst landet der Kunde auf der Datenbank eines anderen.
# ohrganize-provision.sh vergibt Ports ab 3100 und hält beides zusammen.
#
# Das Backend lauscht ohne OHRGANIZE_HOST ausschließlich auf 127.0.0.1. Genau so
# soll es bleiben: erreichbar ist die Instanz nur über den Proxy.
OHRGANIZE_PORT=__PORT__


# ---------------------------------------------------------------------------
# Erlaubte Herkünfte (CORS)
# ---------------------------------------------------------------------------
# Das Portal läuft same-origin über denselben Namen und bräuchte gar keine
# Liste. Sie steht trotzdem hier, und zwar wegen der Desktop-Arbeitsplätze:
# oHRganize.exe lädt seine Oberfläche über ein eigenes Schema und sendet die
# Herkunft "ohrganize://app". Fehlt der Eintrag, kommt aus der
# HR-Administration keine einzige Anfrage durch, während das Portal
# weiterläuft — ein Fehlerbild, das nach Netzwerkproblem aussieht.
#
# Eine ausdrückliche Liste ist außerdem enger als die Voreinstellung: Ohne
# Liste spiegelt das Backend jede anfragende Herkunft zurück.
OHRGANIZE_CORS_ORIGIN=https://__DOMAIN__,ohrganize://app


# ---------------------------------------------------------------------------
# Protokollierung
# ---------------------------------------------------------------------------
# 'warn' enthält fehlgeschlagene Anmeldungen und die Login-Drosselung; 'info'
# schriebe ein vollständiges Bewegungsprofil über jede geöffnete Personalakte.
# Auf einem System mit mehreren Kunden im selben Journal ist das besonders
# unerwünscht. Zur Fehlersuche zeitweise hochsetzen, danach zurückstellen.
OHRGANIZE_LOG_LEVEL=warn


# ---------------------------------------------------------------------------
# Datensicherung
# ---------------------------------------------------------------------------
# Zielverzeichnis für manuelle Aufrufe von backup.cjs. Die Unit
# ohrganize-backup@__KUNDE__.service übergibt --out ohnehin ausdrücklich.
OHRGANIZE_BACKUP_DIR=/var/backups/ohrganize/__KUNDE__


# ---------------------------------------------------------------------------
# Sitzungen (optional)
# ---------------------------------------------------------------------------
# Portal: Vorgabe 1h, verlängert bei Aktivität (spätestens nach der halben
# Laufzeit). Unter 1h endet eine Sitzung ohne Eingabe schon nach dieser
# Laufzeit; länger als 8h ist nicht zu empfehlen.
# OHRGANIZE_TOKEN_TTL=1h
# Desktop-App: Vorgabe 3d, verlängert nach 10 Minuten (spätestens nach der
# halben Laufzeit), solange die App läuft; die Laufzeit muss nur den
# Ruhezustand des Rechners überbrücken.
# OHRGANIZE_DESKTOP_TOKEN_TTL=3d
# Höchstdauer einer Sitzung ab der Anmeldung (danach neu anmelden):
# Portal Vorgabe 6h, Desktop-App Vorgabe 5d.
# OHRGANIZE_SESSION_MAX=6h
# OHRGANIZE_DESKTOP_SESSION_MAX=5d
