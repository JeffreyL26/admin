# oHRganize Datensicherung — einmaliger Lauf, angestoßen von ohrganize-backup.timer
#
# Ablage: /etc/systemd/system/ohrganize-backup.service
# Manuell auslösen: systemctl start ohrganize-backup.service
#
# Das Skript darf im laufenden Betrieb starten: Es benutzt die
# Online-Backup-API von SQLite und braucht keine Auszeit des Dienstes.

[Unit]
Description=oHRganize Datensicherung (Datenbank, Dateien, Secret)
Documentation=file:/opt/ohrganize/deploy/README.md
# Nicht sichern, während der Dienst gerade neu startet oder gestoppt wurde:
# Ohne laufenden Dienst ist die Sicherung zwar trotzdem gültig, aber ein
# gestoppter Dienst ist meistens ein Hinweis auf einen laufenden Eingriff.
After=ohrganize-backend.service

[Service]
Type=oneshot
User=ohrganize
Group=ohrganize
WorkingDirectory=/opt/ohrganize/apps/backend

EnvironmentFile=/etc/ohrganize/ohrganize.env

# --keep 14: vierzehn Sicherungen bleiben liegen, ältere werden gelöscht.
# Bei täglichem Lauf sind das zwei Wochen. Diese Aufbewahrung ersetzt KEINE
# Auslagerung: Eine Sicherung, die nur auf demselben Server liegt, überlebt
# weder einen Plattendefekt noch eine Verschlüsselung durch Ransomware.
# Wie sie vom Server heruntergeholt wird, steht in deploy/README.md.
ExecStart=/usr/bin/node /opt/ohrganize/apps/backend/dist/backup.cjs --out /var/backups/ohrganize --keep 14

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

# --- Härtung ----------------------------------------------------------------
# Gemessen auf einem Debian-13-Testserver (Sicherung bleibt vollständig):
# `systemd-analyze security` fällt von 6.6 MEDIUM auf 0.2 SAFE.
# Ausführliche Begründung je Direktive: ohrganize-backend@.service.
CapabilityBoundingSet=
AmbientCapabilities=

# EIN ~ am Zeilenanfang gilt für die ganze Liste — sonst verwirft systemd die
# übrigen Gruppen still als unbekannte Syscall-Namen.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @module @reboot @swap @raw-io @cpu-emulation @clock
SystemCallErrorNumber=EPERM

ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
PrivateMounts=true
KeyringMode=private
DevicePolicy=closed
DeviceAllow=
PrivateUsers=true

# Die Sicherung braucht kein Netz: SQLite-Online-Backup plus Dateikopie. Ein
# leerer Netz-Namensraum nimmt einem eingeschleusten Befehl die Möglichkeit,
# die kopierte Personalakte fortzuschicken.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# Lesen der Datenbank verlangt SCHREIBrechte: SQLite legt im WAL-Modus für jede
# Verbindung -shm/-wal an. /var/lib/ohrganize muss deshalb beschreibbar sein,
# nicht nur lesbar.
ReadWritePaths=/var/lib/ohrganize /var/backups/ohrganize

# /var/backups/ohrganize wird NICHT automatisch angelegt (es liegt außerhalb von
# StateDirectory). Einmalig:
#   install -d -o ohrganize -g ohrganize -m 0700 /var/backups/ohrganize

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ohrganize-backup
