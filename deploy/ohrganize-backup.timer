# Zeitplan der oHRganize-Datensicherung
#
# Ablage:     /etc/systemd/system/ohrganize-backup.timer
# Aktivieren: systemctl enable --now ohrganize-backup.timer
# Prüfen:     systemctl list-timers ohrganize-backup.timer

[Unit]
Description=Tägliche oHRganize-Datensicherung
Documentation=file:/opt/ohrganize/deploy/README.md

[Timer]
# Täglich um 02:30 Ortszeit. Die Sicherung läuft im laufenden Betrieb, die
# Uhrzeit ist trotzdem außerhalb der Arbeitszeit gewählt: Der Kopiervorgang von
# storage/ belastet die Platte.
OnCalendar=*-*-* 02:30:00
# Streut den Start um bis zu 5 Minuten, damit nicht alle Timer eines Servers
# gleichzeitig loslaufen.
RandomizedDelaySec=300
# War der Server zur geplanten Zeit aus, wird die Sicherung nach dem Start
# nachgeholt.
Persistent=true
Unit=ohrganize-backup.service

[Install]
WantedBy=timers.target
