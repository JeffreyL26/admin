# oHRganize Datensicherung EINER Kundeninstanz — angestoßen von ohrganize-backup@.timer
#
# Ablage: /etc/systemd/system/ohrganize-backup@.service
# Manuell auslösen: systemctl start ohrganize-backup@musterfirma.service
#
# Das Skript darf im laufenden Betrieb starten: Es benutzt die
# Online-Backup-API von SQLite und braucht keine Auszeit des Dienstes.

[Unit]
Description=oHRganize Datensicherung — Kunde %i
Documentation=file:/opt/ohrganize/deploy/README.md
After=ohrganize-backend@%i.service

[Service]
Type=oneshot
User=ohrganize
Group=ohrganize
WorkingDirectory=/opt/ohrganize/kunden/%i/apps/backend

EnvironmentFile=/etc/ohrganize/kunden/%i.env

# --keep 14: vierzehn Sicherungen je Kunde. Diese Aufbewahrung ersetzt KEINE
# Auslagerung — eine Sicherung auf demselben Server überlebt weder einen
# Plattendefekt noch eine Verschlüsselung durch Ransomware.
#
# Getrennte Zielverzeichnisse je Kunde sind Pflicht, nicht Ordnungsliebe: Beim
# Herausgeben oder Löschen der Daten eines Kunden (Vertragsende, Art. 17 DSGVO)
# muss klar sein, welche Dateien dazugehören. In einem gemeinsamen Topf ließe
# sich das nur noch am Dateinamen raten.
ExecStart=/usr/bin/node /opt/ohrganize/kunden/%i/apps/backend/dist/backup.cjs --out /var/backups/ohrganize/%i --keep 14

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

# --- Härtung ----------------------------------------------------------------
# Gemessen auf einem Debian-13-Testserver: Der Lauf erzeugt weiterhin eine
# vollständige Sicherung (Datenbank, secret.key, storage/, MANIFEST.txt);
# `systemd-analyze security` fällt von 6.6 MEDIUM auf 0.2 SAFE.
CapabilityBoundingSet=
AmbientCapabilities=

# EIN ~ am Zeilenanfang gilt für die ganze Liste (siehe die ausführliche
# Warnung in ohrganize-backend@.service).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @module @reboot @swap @raw-io @cpu-emulation @clock
SystemCallErrorNumber=EPERM

ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
PrivateMounts=true
KeyringMode=private
DevicePolicy=closed
DeviceAllow=
PrivateUsers=true

# Anders als das Backend braucht die Sicherung ÜBERHAUPT kein Netz: Sie liest
# die Datenbank über die Online-Backup-API von SQLite und kopiert Dateien.
# Ein eigener, leerer Netz-Namensraum nimmt einem eingeschleusten Befehl damit
# jede Möglichkeit, die kopierte Personalakte irgendwohin zu schicken.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# Lesen der Datenbank verlangt SCHREIBrechte: SQLite legt im WAL-Modus für jede
# Verbindung -shm/-wal an. Beide Pfade müssen deshalb beschreibbar sein.
ReadWritePaths=/var/lib/ohrganize/%i /var/backups/ohrganize/%i

# --- Leseisolation ----------------------------------------------------------
# Wie beim Backend, hier ueber BEIDE Baeume: Ein Sicherungslauf, der ausser
# Kontrolle geraet, darf die Daten und die Sicherungen fremder Kunden nicht
# einmal lesen koennen. Die Sicherung ist genau der Prozess, der einen
# vollstaendigen Abzug in der Hand haelt.
TemporaryFileSystem=/var/lib/ohrganize:ro /var/backups/ohrganize:ro
BindPaths=/var/lib/ohrganize/%i /var/backups/ohrganize/%i

# Ressourcengrenzen: Das Kopieren von storage/ soll nachts nicht den ganzen
# Host beschaeftigen. IOWeight niedriger als beim Backend, weil ein
# verzoegerter Sicherungslauf niemanden stoert, eine langsame API aber schon.
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
CPUWeight=50
IOWeight=50

# /var/backups/ohrganize/<kunde> wird NICHT automatisch angelegt (es liegt
# außerhalb von StateDirectory). ohrganize-provision.sh erledigt das beim
# Anlegen des Kunden; von Hand:
#   install -d -o ohrganize -g ohrganize -m 0700 /var/backups/ohrganize/<kunde>

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ohrganize-backup-%i
