# oHRganize Datensicherung EINER Kundeninstanz — angestoßen von ohrganize-backup@.timer
#
# Ablage: /etc/systemd/system/ohrganize-backup@.service
# Manuell auslösen: systemctl start ohrganize-backup@musterfirma.service
#
# Das Skript darf im laufenden Betrieb starten: Es benutzt die
# Online-Backup-API von SQLite und braucht keine Auszeit des Dienstes.

[Unit]
Description=oHRganize Datensicherung — Kunde %i
Documentation=file:/opt/ohrganize/deploy/README.md
After=ohrganize-backend@%i.service

[Service]
Type=oneshot
User=ohrganize
Group=ohrganize
WorkingDirectory=/opt/ohrganize/apps/backend

EnvironmentFile=/etc/ohrganize/kunden/%i.env

# --keep 14: vierzehn Sicherungen je Kunde. Diese Aufbewahrung ersetzt KEINE
# Auslagerung — eine Sicherung auf demselben Server überlebt weder einen
# Plattendefekt noch eine Verschlüsselung durch Ransomware.
#
# Getrennte Zielverzeichnisse je Kunde sind Pflicht, nicht Ordnungsliebe: Beim
# Herausgeben oder Löschen der Daten eines Kunden (Vertragsende, Art. 17 DSGVO)
# muss klar sein, welche Dateien dazugehören. In einem gemeinsamen Topf ließe
# sich das nur noch am Dateinamen raten.
ExecStart=/usr/bin/node /opt/ohrganize/apps/backend/dist/backup.cjs --out /var/backups/ohrganize/%i --keep 14

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

# Lesen der Datenbank verlangt SCHREIBrechte: SQLite legt im WAL-Modus für jede
# Verbindung -shm/-wal an. Beide Pfade müssen deshalb beschreibbar sein.
ReadWritePaths=/var/lib/ohrganize/%i /var/backups/ohrganize/%i

# /var/backups/ohrganize/<kunde> wird NICHT automatisch angelegt (es liegt
# außerhalb von StateDirectory). ohrganize-provision.sh erledigt das beim
# Anlegen des Kunden; von Hand:
#   install -d -o ohrganize -g ohrganize -m 0700 /var/backups/ohrganize/<kunde>

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ohrganize-backup-%i
