# oHRganize Backend — systemd-VORLAGE für den Mehrkunden-Betrieb
#
# Ablage:      /etc/systemd/system/ohrganize-backend@.service
# Einrichtung: deploy/README.md, Abschnitt „Mehrere Kunden auf einem Server"
# Anlegen:     deploy/ohrganize-provision.sh anlegen <kunde>
#
# %i ist der Kundenschlüssel (Subdomain-Label, z. B. "musterfirma"):
#   systemctl start ohrganize-backend@musterfirma
#
# Warum eine Vorlage statt einer Unit je Kunde: oHRganize ist bewusst NICHT
# mandantenfähig — ein Prozess, eine SQLite-Datei, ein Datenverzeichnis. Jeder
# Kunde bekommt deshalb eine eigene Instanz mit eigenem Port und eigenen Daten.
# Eine Vorlage hält die Härtung an EINER Stelle; bei kopierten Units driften
# die Sicherheitsoptionen nach der dritten Kopie auseinander.
#
# Diese Datei ersetzt ohrganize-backend.service NICHT, sie steht daneben:
# Einzelkunden-Server nutzen weiter die einfache Unit. Beide gleichzeitig zu
# betreiben ist möglich, aber unnötig verwirrend.
#
# Annahmen (identisch zur Einzel-Unit, dort stehen die ausführlichen Gründe):
#   Programm:       /opt/ohrganize/kunden/<kunde>  (SYMLINK auf ein Release)
#   Releases:       /opt/ohrganize/releases/<variante>-<version>
#   Daten:          /var/lib/ohrganize/<kunde>
#   Konfiguration:  /etc/ohrganize/kunden/<kunde>.env
#   Dienstbenutzer: ohrganize:ohrganize
#
# Warum ein Symlink je Instanz statt eines gemeinsamen Programmverzeichnisses:
#   1. Auf einem Host koennen verschiedene AUSGABEN laufen (Land x Edition).
#      Ein gemeinsames /opt/ohrganize traegt genau eine.
#   2. Ein Update wird instanzweise umgestellt und ist zuruecknehmbar: Der
#      Symlink zeigt wieder auf das vorherige Release, fertig. Ohne ihn
#      muesste das alte Archiv erneut entpackt werden, waehrend der Kunde steht.
#   3. Eine Instanz laesst sich absichtlich auf einem alten Stand festhalten
#      (Pinnen), ohne die anderen daran zu hindern weiterzuziehen.

[Unit]
Description=oHRganize Backend — Kunde %i
Documentation=file:/opt/ohrganize/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ohrganize
Group=ohrganize
WorkingDirectory=/opt/ohrganize/kunden/%i/apps/backend

# dist/cli.cjs ist der CLI-Einstieg mit Selbststart und Signal-Handling —
# NICHT dist/server.cjs (Embedding-Bundle der Desktop-App, startet nichts).
ExecStart=/usr/bin/node /opt/ohrganize/kunden/%i/apps/backend/dist/cli.cjs

# Port und Datenverzeichnis stehen je Kunde in dieser Datei. Sie wird von
# ohrganize-provision.sh aus deploy/ohrganize-kunde.env.example erzeugt.
# Fehlt sie, startet die Instanz nicht (kein stiller Rückfall auf gemeinsame
# Vorgaben — sonst schrieben zwei Kunden in dieselbe Datenbank).
EnvironmentFile=/etc/ohrganize/kunden/%i.env

# Legt /var/lib/ohrganize/%i an, setzt den Eigentümer auf den Dienstbenutzer
# und macht es trotz ProtectSystem=strict beschreibbar. OHRGANIZE_DATA_DIR in
# der env-Datei muss auf denselben Pfad zeigen.
StateDirectory=ohrganize/%i
StateDirectoryMode=0700

# 0077 => Dateien 0600, Verzeichnisse 0700. In storage/ liegen AU-Bescheinigungen
# und Verträge, in ohrganize.db die komplette Personalakte. Im Mehrkunden-Betrieb
# kommt ein zweiter Grund dazu: Alle Instanzen laufen unter DEMSELBEN
# Dienstbenutzer. Der Schutz zwischen den Kunden ist damit die
# Verzeichnisstruktur plus ReadWritePaths unten, nicht die Benutzertrennung.
# Wer echte Isolation je Kunde braucht (getrennte Unix-Konten, Container),
# findet den Weg in deploy/README.md beschrieben.
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Bleibt AUS: V8 kompiliert zur Laufzeit, mit true startet Node nicht.
MemoryDenyWriteExecute=false

# --- Härtung: Rechte, Syscalls, /proc, Netz ---------------------------------
# Alles hier ist auf einem Debian-13-Testserver gemessen worden: Start,
# Erstinbetriebnahme, API, Login mit bcrypt und Audit-Schreibvorgang,
# Schreiben in storage/, WAL-Checkpoint beim Stoppen und ein Dauerlauf über
# 60 Messungen ohne einen einzigen Neustart. `systemd-analyze security` fällt
# damit von 5.1 MEDIUM auf 0.9 SAFE.

# Der Dienst braucht KEINE einzige Capability: Er läuft als ohrganize, lauscht
# auf Port ≥1024 und fasst nur sein eigenes Datenverzeichnis an. Die leere
# Menge nimmt ihm auch die, die er über einen Fehler erben könnte.
CapabilityBoundingSet=
AmbientCapabilities=

# Systemaufruf-Filter. Erste Zeile ist die Erlaubnisliste, zweite die
# Sperrliste.
#
# ACHTUNG, SCHREIBWEISE: Das ~ steht EINMAL am Zeilenanfang und gilt für die
# ganze Liste. Schreibt man "~@privileged ~@resources", liest systemd nur die
# erste Gruppe als Sperre und die übrigen als unbekannte Syscall-NAMEN, die es
# stillschweigend verwirft — der Filter ist dann viel schwächer als er
# aussieht. Genau das ist im Testlauf passiert und nur aufgefallen, weil
# `systemd-analyze verify` es meldet. Nach jeder Änderung deshalb:
#   systemd-analyze verify /etc/systemd/system/ohrganize-backend@.service
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @module @reboot @swap @raw-io @cpu-emulation @clock
# EPERM statt Signal: Ein gefilterter Aufruf gibt einen Fehler zurück, statt
# den Prozess zu töten — im Zweifel läuft der Dienst weiter und die Ursache
# steht im Journal.
SystemCallErrorNumber=EPERM

# Der Prozess sieht im /proc nur sich selbst und keine Kernel-Schnittstellen.
# Wogegen das schützt: Wer über eine Lücke im Dienst Code ausführt, kann sonst
# die Kommandozeilen und Umgebungen ALLER Prozesse lesen — dort stehen auf
# einem Mehrkunden-Server die Pfade und Variablen der anderen Instanzen.
ProtectProc=invisible
ProcSubset=pid

RemoveIPC=true
PrivateMounts=true
KeyringMode=private
DevicePolicy=closed
DeviceAllow=

# Eigener Benutzer-Namensraum: Die Kennungen des Systems (inkl. root) sind für
# den Dienst nicht mehr dieselben. Neu angelegte Dateien gehören trotzdem
# weiterhin ohrganize:ohrganize — nachgemessen an Datenbank, secret.key und
# storage/ einer frisch angelegten Instanz.
PrivateUsers=true

# Netzverkehr nur über die Loopback-Adresse. Der Reverse-Proxy sitzt auf
# derselben Maschine, das Backend ruft von sich aus nirgendwo an.
#
# WENN Proxy und Backend auf VERSCHIEDENEN Maschinen laufen (OHRGANIZE_HOST
# gesetzt, siehe ohrganize.env.example), sind diese beiden Zeilen zu ändern:
# dann gehört die Adresse des Proxys in IPAddressAllow=, sonst weist der
# Dienst dessen Verbindungen ab.
IPAddressAllow=localhost
IPAddressDeny=any

# Beschreibbar ist ausschließlich das EIGENE Datenverzeichnis. Das ist die
# Grenze zwischen den Kunden: Ein Fehler in Instanz A kann die Datenbank von
# Instanz B nicht überschreiben, obwohl beide unter demselben Konto laufen.
ReadWritePaths=/var/lib/ohrganize/%i

# --- Leseisolation zwischen den Instanzen ------------------------------------
# ReadWritePaths oben verhindert das SCHREIBEN in fremde Verzeichnisse, nicht
# das LESEN: Alle Instanzen laufen unter demselben Konto, also konnte jede die
# Personalakte jeder anderen mitlesen. TemporaryFileSystem legt ein leeres
# tmpfs ueber /var/lib/ohrganize; BindPaths blendet danach genau das eigene
# Verzeichnis wieder ein. Ergebnis: Ein Verzeichnislauf aus dem Dienst heraus
# zeigt nur die eigene Instanz, fremde Pfade existieren fuer ihn nicht.
#
# REIHENFOLGE ZAEHLT: TemporaryFileSystem wird vor BindPaths ausgewertet, und
# beide wirken erst nach StateDirectory. Deshalb bleibt StateDirectory oben
# stehen (es legt das Verzeichnis an und setzt den Eigentuemer), waehrend die
# Sichtbarkeit hier geregelt wird. Nach jeder Aenderung an diesen beiden
# Zeilen pruefen, dass die Instanz startet UND schreibt:
#   systemctl restart ohrganize-backend@<kunde>
#   runuser -u ohrganize -- ls /var/lib/ohrganize    (zeigt nur <kunde>)
TemporaryFileSystem=/var/lib/ohrganize:ro
BindPaths=/var/lib/ohrganize/%i

# Sicherungen fremder Kunden: Das Backend braucht den Sicherungsbaum nie (die
# Sicherung laeuft in einer eigenen Unit), also ist er hier ganz unsichtbar.
# Ohne diese Zeile konnte jede Instanz die Sicherungen aller anderen lesen,
# und eine Sicherung enthaelt den vollstaendigen Bestand samt data.key. Das
# Minuszeichen laesst die Unit auch starten, wenn es das Verzeichnis (noch)
# nicht gibt.
InaccessiblePaths=-/var/backups/ohrganize

# --- Ressourcengrenzen ------------------------------------------------------
# Startwerte, damit eine einzelne Instanz den Host nicht mitnimmt: Ein
# Exportlauf ueber eine grosse Belegschaft oder eine Endlosschleife nach einem
# Fehler wuerde sonst alle anderen Kunden ausbremsen. MemoryHigh drosselt
# (der Kernel raeumt auf und bremst), MemoryMax beendet. Nach einem Dauerlauf
# mit echten Bestaenden justieren; die gemessenen Werte gehoeren in
# deploy/README.md, Abschnitt 9.7.
# Gemessen auf Debian 13 am 2026-09-15 (leere Bestaende, 300 Health- und 30
# Login-Aufrufe): MemoryPeak 60 bis 63 MB je Instanz, 11 Tasks. Die Grenzen
# lassen damit reichlich Luft; vor dem Senken mit echten Bestaenden messen.
MemoryHigh=512M
MemoryMax=768M
TasksMax=256
CPUWeight=100
IOWeight=100

Restart=on-failure
RestartSec=5

# SIGTERM => index.ts schließt den Server und führt einen WAL-Checkpoint aus.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
# Damit `journalctl -t ohrganize-musterfirma` genau einen Kunden zeigt.
SyslogIdentifier=ohrganize-%i

[Install]
WantedBy=multi-user.target
