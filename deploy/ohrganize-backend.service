# oHRganize Backend — systemd-Dienst
#
# Ablage:      /etc/systemd/system/ohrganize-backend.service
# Einrichtung: deploy/README.md
# Erstlauf:    docs/inbetriebnahme.md
#
# Annahmen (an einer Stelle ändern, dann überall):
#   Programm:          /opt/ohrganize            (ausgecheckter/entpackter Stand)
#   Daten:             /var/lib/ohrganize        (Datenbank, storage/, secret.key)
#   Konfiguration:     /etc/ohrganize/ohrganize.env
#   Dienstbenutzer:    ohrganize:ohrganize       (Systemkonto ohne Login-Shell)

[Unit]
Description=oHRganize Backend (HR-Verwaltung, REST-API)
Documentation=file:/opt/ohrganize/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ohrganize
Group=ohrganize
WorkingDirectory=/opt/ohrganize/apps/backend

# dist/cli.cjs entsteht aus `npm run build -w apps/backend`. Es ist der
# CLI-Einstieg mit Selbststart und Signal-Handling — NICHT dist/server.cjs,
# das ist das Embedding-Bundle der Desktop-App und startet nichts.
# better-sqlite3 ist im Bundle als --external markiert und muss deshalb in
# node_modules neben dem Programmverzeichnis liegen (npm ci, siehe README).
ExecStart=/usr/bin/node /opt/ohrganize/apps/backend/dist/cli.cjs

EnvironmentFile=/etc/ohrganize/ohrganize.env

# StateDirectory legt /var/lib/ohrganize beim Start an (falls nicht vorhanden),
# setzt den Eigentümer auf den Dienstbenutzer und macht es trotz
# ProtectSystem=strict beschreibbar. OHRGANIZE_DATA_DIR in der env-Datei muss auf
# denselben Pfad zeigen.
StateDirectory=ohrganize
StateDirectoryMode=0700

# 0077 => neu erzeugte Dateien 0600, Verzeichnisse 0700.
# Wogegen das schützt: In storage/ liegen AU-Bescheinigungen, Verträge und
# Entgeltbescheinigungen als blanke Dateien, in ohrganize.db die komplette
# Personalakte. Mit dem Node-Standard (0644/0755) darf jedes lokale Konto auf
# dem Server mitlesen — Monitoring-Agent, Webserver-Benutzer, jede Shell.
# Das Backend zieht die Rechte zusätzlich selbst nach (config.ts,
# hardenDataPermissions); diese Zeile deckt alles ab, was sonst noch entsteht.
UMask=0077

# Rechteausweitung und Zugriff auf alles, was nicht gebraucht wird, abschneiden.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# MemoryDenyWriteExecute bleibt AUS: V8 kompiliert zur Laufzeit und braucht
# beschreibbar-ausführbare Seiten. Mit true startet Node nicht.
MemoryDenyWriteExecute=false

# ProtectSystem=strict macht das gesamte Dateisystem außer /dev, /proc und /sys
# schreibgeschützt. Beschreibbar bleibt nur das Datenverzeichnis (StateDirectory
# erlaubt es bereits; hier noch einmal ausdrücklich, damit ein abweichendes
# OHRGANIZE_DATA_DIR sofort auffällt).
ReadWritePaths=/var/lib/ohrganize

Restart=on-failure
RestartSec=5

# Beim Stoppen schickt systemd SIGTERM. index.ts schließt daraufhin den Server
# und führt einen WAL-Checkpoint aus (sonst stehen die jüngsten Änderungen nur
# in ohrganize.db-wal). Der Handler bricht selbst nach 10 s ab, TimeoutStopSec
# liegt bewusst darüber.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ohrganize-backend

[Install]
WantedBy=multi-user.target
